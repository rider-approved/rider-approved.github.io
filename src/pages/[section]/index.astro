---
import Layout from '../../layouts/Layout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { catalog, getSection } from '../../config/catalog';
import { countsByCategory } from '../../lib/catalog';
import { t } from '../../i18n/index';

export function getStaticPaths() {
  return catalog.map((section) => ({ params: { section: section.slug } }));
}

const { section } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = getSection(section!)!;
const counts = await countsByCategory(section!);

const ordered = [...current.categories].sort(
  (a, b) => Number(counts[a.slug] === 0) - Number(counts[b.slug] === 0)
);
---

<Layout title={t(current.labelKey)}>
  <Fragment slot="subnav">
    <CategoryNav sectionSlug={section!} />
  </Fragment>

  <div class="py-8">
    <h1 class="text-h1 font-bold text-primary mb-2.5">{t(current.labelKey)}</h1>
    <p class="text-body-base text-muted mb-8">{t('site.tagline')}</p>

    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {
        ordered.map((c) => (
          <li>
            <a
              href={`${base}${section}/${c.slug}/`}
              class="flex flex-col gap-2 bg-surface border border-line rounded-card p-4 hover:border-accent transition-colors min-h-tap"
            >
              <svg
                viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4"
                class="w-7 h-7 text-line" aria-hidden="true" set:html={c.icon}
              />
              <span class="text-body-sm font-semibold text-primary">{t(c.labelKey)}</span>
              <span class="font-mono text-[0.78rem] text-muted">{counts[c.slug] ?? 0}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
