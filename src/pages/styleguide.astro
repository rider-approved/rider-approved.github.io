---
import Layout from '../layouts/Layout.astro';
import Disclosure from '../components/Disclosure.astro';
import EmptyState from '../components/EmptyState.astro';
import BuyLinks from '../components/BuyLinks.astro';
import SpecTable from '../components/SpecTable.astro';
import AdaptationNotes from '../components/AdaptationNotes.astro';
import HazardRule from '../components/HazardRule.astro';
import { catalog } from '../config/catalog';

const COLORS = [
  '--bg', '--surface', '--line', '--line-subtle',
  '--accent', '--accent-dim', '--accent-text', '--accent-ink',
  '--text', '--text-body', '--text-muted', '--warn',
];

const TYPE = [
  { cls: 'text-display font-bold', label: 'display / 44', face: 'Inter' },
  { cls: 'text-display font-bold font-display', label: 'display / 44', face: 'Barlow Condensed' },
  { cls: 'text-h1 font-bold', label: 'h1 / 32', face: 'Inter' },
  { cls: 'text-h1 font-bold font-display', label: 'h1 / 32', face: 'Barlow Condensed' },
  { cls: 'text-h3 font-bold', label: 'h3 / 21', face: 'Inter' },
  { cls: 'text-h3 font-bold font-display', label: 'h3 / 21', face: 'Barlow Condensed' },
  { cls: 'text-verdict', label: 'verdict / 17.5', face: 'Inter' },
  { cls: 'text-verdict font-display', label: 'verdict / 17.5', face: 'Barlow Condensed' },
  { cls: 'text-body-base', label: 'body / 16.5', face: 'Inter' },
  { cls: 'text-body-base font-display', label: 'body / 16.5', face: 'Barlow Condensed' },
  { cls: 'text-body-sm', label: 'body-sm / 15.5', face: 'Inter' },
  { cls: 'text-body-sm font-display', label: 'body-sm / 15.5', face: 'Barlow Condensed' },
  { cls: 'text-meta', label: 'meta / 13.5', face: 'Inter' },
  { cls: 'text-meta font-display', label: 'meta / 13.5', face: 'Barlow Condensed' },
  { cls: 'text-label uppercase font-bold', label: 'label / 13 upper', face: 'Inter' },
  { cls: 'text-label uppercase font-bold font-display', label: 'label / 13 upper', face: 'Barlow Condensed' },
  { cls: 'text-micro uppercase font-bold', label: 'micro / 11.5 upper', face: 'Inter' },
  { cls: 'text-micro uppercase font-bold font-display', label: 'micro / 11.5 upper', face: 'Barlow Condensed' },
];

const now = new Date();
const stale = new Date(Date.now() - 77 * 86400000);
---

<Layout title="Style guide" noindex={true}>
  <div class="max-w-[820px] mx-auto py-6">
    <h1 class="text-h1 font-bold text-primary mb-2">Style guide</h1>
    <p class="text-body-base text-muted mb-10">
      Every token and component. Check here before building a new screen — this is what stops
      screens drifting apart.
    </p>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Colour tokens</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {
          COLORS.map((token) => (
            <div class="border border-line rounded-card overflow-hidden">
              <div class="h-14" style={`background: var(${token})`}></div>
              <p class="font-mono text-[0.75rem] text-muted px-2.5 py-2">{token}</p>
            </div>
          ))
        }
      </div>
      <p class="text-meta text-muted mt-3">
        Contrast ratios are asserted by <code class="font-mono">npm run check:contrast</code>.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Type scale</h2>
      {
        TYPE.map((t) => (
          <div class="flex items-baseline gap-5 border-b border-line-subtle py-3">
            <span class="font-mono text-[0.72rem] text-muted w-32 shrink-0">{t.label} <span class="text-xs text-muted">{t.face}</span></span>
            <span class:list={[t.cls, 'text-primary']}>Michelin Road 6</span>
          </div>
        ))
      }
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Hazard rule &amp; grain</h2>
      <HazardRule size="thick" />
      <div class="h-4"></div>
      <HazardRule />
      <div class="grain bg-surface border border-line rounded-card mt-4 h-20"></div>
      <p class="text-meta text-muted mt-2">
        Grain sits on chrome only. The panel above is deliberately empty: texture never sits behind
        body copy, so the checker keeps describing what actually renders.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Disclosure</h2>
      <div class="border-t border-line-subtle">
        <Disclosure summary="Especificações completas">
          <p class="text-body-sm text-body">Conteúdo suplementar — nunca a análise principal.</p>
        </Disclosure>
        <Disclosure summary="Manual e documentos">
          <p class="text-body-sm text-body">Segunda seção, fechada por padrão.</p>
        </Disclosure>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Buy links — fresh and stale</h2>
      <BuyLinks
        links={[
          { label: 'Mercado Livre', url: 'https://example.com', price: 1890, checkedAt: now, featured: true },
          { label: 'Amazon', url: 'https://example.com', price: 1940, checkedAt: stale, featured: false },
        ]}
      />
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Spec table &amp; adaptation notes</h2>
      <p class="text-meta text-muted mb-4">
        Sample data. No real product carries specs or fitting notes yet, so this page is
        where those two components are exercised.
      </p>
      <SpecTable
        specs={[
          { label: 'Medida dianteira', value: '120/70 ZR17' },
          { label: 'Durabilidade', value: '~10.000 km' },
        ]}
      />
      <div class="mt-4">
        <AdaptationNotes
          notes={[
            'Confirme a medida original antes de comprar.',
            'Peça balanceamento com peso adesivo interno.',
          ]}
        />
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Empty state</h2>
      <EmptyState sectionSlug="kawasaki-eliminator-500" categorySlug="bancos" categoryLabel="Bancos" />
    </section>

    <section class="mb-10">
      <h2 class="text-label uppercase font-bold text-accent-text mb-4">Category icons</h2>
      <div class="flex flex-wrap gap-3">
        {
          catalog.flatMap((s) =>
            s.categories.map((c) => (
              <div class="w-24 border border-line rounded-card p-3 text-center">
                <svg
                  viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4"
                  class="w-8 h-8 mx-auto text-line" aria-hidden="true" set:html={c.icon}
                />
                <span class="block font-mono text-[0.65rem] text-muted mt-2 break-words">{c.slug}</span>
              </div>
            ))
          )
        }
      </div>
    </section>
  </div>
</Layout>
