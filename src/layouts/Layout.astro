---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = t('site.tagline'), noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title} — {t('site.name')}</title>
    <script is:inline>
      // Dark is the default. Light applies only when explicitly chosen, so a
      // visitor with no stored preference gets dark — including with JS disabled,
      // because the attribute below is server-rendered.
      try {
        if (localStorage.getItem('rider-theme') === 'light') {
          delete document.documentElement.dataset.theme;
        }
      } catch (_) {}
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-bg text-body">
    <Header><slot name="subnav" slot="subnav" /></Header>
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        if (next === 'dark') root.dataset.theme = 'dark';
        else delete root.dataset.theme;
        try {
          // Only the non-default is stored, so clearing site data returns to dark.
          if (next === 'light') localStorage.setItem('rider-theme', 'light');
          else localStorage.removeItem('rider-theme');
        } catch (_) {}
      });
    </script>
  </body>
</html>

