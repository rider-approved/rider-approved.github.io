---
import { t } from '../i18n/index';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="border-b border-line">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between grain">
    <a href={base} class="text-xl font-bold font-display text-accent-text hover:opacity-80 transition-opacity">
      {t('site.name')}
    </a>
    <button
      id="theme-toggle"
      type="button"
      aria-label={t('theme.toggle')}
      class="text-muted hover:text-primary transition-colors p-3 -m-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      <svg class="icon-moon w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg class="icon-sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
    </button>
  </div>
  <slot name="subnav" />
</header>
